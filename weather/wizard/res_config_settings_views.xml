<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.weather</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Weather" data-string="Weather" name="weather_management"
                    logo="/weather/static/description/icon.png">
                    <block title="Api Keys" name="weather_api_keys_block">
                        <setting id="weather_api_key_settings"
                                 help="Login and get your Weather API Key from: https://www.weatherapi.com/"
                                 documentation="https://www.weatherapi.com/">
                            <field name="weather_api_key" placeholder="Enter your Weather API key" password="True"/>
                        </setting>

                        <setting id="position_stack_api_key_settings"
                                 help="Login and get your Position Stack API Key from: https://www.positionstack.com/"
                                 documentation="https://www.positionstack.com/">
                            <field name="position_stack_api_key" placeholder="Enter your Position Stack API key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="weather_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'weather_management', 'bin_size': False}</field>
    </record>

</odoo>