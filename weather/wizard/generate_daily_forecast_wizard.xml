<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="generate_daily_forecast_wizard_view_form" model="ir.ui.view">
        <field name="name">generate.daily.forecast.wizard.form</field>
        <field name="model">generate.daily.forecast.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group col="1">
                    <field name="date_from"/>
                    <field name="days_forecast"/>
                    <field name="location_id"/>
                </group>
                <footer>
                    <button string="Generate Weather Forecast"
                            name="generate_weather_forecast"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="generate_daily_forecast_action" model="ir.actions.act_window">
        <field name="name">Generate Daily Forecast</field>
        <field name="res_model">generate.daily.forecast.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="generate_daily_forecast_wizard_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>
