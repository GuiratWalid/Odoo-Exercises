#. module: weather
#: model:ir.actions.report,print_report_name:weather.weather_alert_report_action
msgid ""
"\n"
"                'Weather Alert Report for %s on %s' % (object.location_id.display_name, object.name)\n"
"            "
msgstr ""
"\n"
"                'Rapport d'alerte météo pour %s le %s' % (object.location_id.name, object.name)\n"
"            "

#. module: weather
#: model:mail.template,body_html:weather.weather_alert_email_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        Tomorrow, the temperature may exceed “\n"
"                        <strong>\n"
"                            <span t-out=\"object.temp_max\"/>\n"
"                        </strong>\n"
"                        ”, the wind speed may be more than “\n"
"                        <strong>\n"
"                            <span t-out=\"object.wind_max\"/>\n"
"                        </strong>\n"
"                        ” and the total amount of precipitation is “\n"
"                        <strong>\n"
"                            <span t-out=\"object.amount_precipitation\"/>\n"
"                        </strong>\n"
"                        ”.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        Demain, la température pourrait dépasser «\n"
"                        <strong>\n"
"                            <span t-out=\"object.temp_max\"/>\n"
"                        </strong>\n"
"                        », la vitesse du vent pourrait dépasser «\n"
"                        <strong>\n"
"                            <span t-out=\"object.wind_max\"/>\n"
"                        </strong>\n"
"                        » et la quantité totale de précipitations sera de «\n"
"                        <strong>\n"
"                            <span t-out=\"object.amount_precipitation\"/>\n"
"                        </strong>\n"
"                        ».\n"
"                    </p>\n"
"                </div>\n"
"            "

