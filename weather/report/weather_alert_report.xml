<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="weather_alert_report_paperformat" model="report.paperformat">
            <field name="name">A4 - Weather Alert Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">15</field>
            <field name="dpi">90</field>
        </record>

        <record id="weather_alert_report_action" model="ir.actions.report">
            <field name="name">Weather Alert Report</field>
            <field name="model">weather.daily.forecast</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">weather.weather_alert_report_template</field>
            <field name="report_file">weather.weather_alert_report_template</field>
            <field name="print_report_name">
                'Weather Alert Report for %s on %s' % (object.location_id.display_name, object.name)
            </field>
            <field name="paperformat_id" ref="weather.weather_alert_report_paperformat"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>