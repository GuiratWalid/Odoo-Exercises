<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record id="weather_alert_email_template" model="mail.template">
            <field name="name">Weather Alert Email Template</field>
            <field name="model_id" ref="weather.model_weather_daily_forecast"/>
            <field name="email_from">{{ user.company_id.email or '' }}</field>
            <field name="subject">Weather Alert</field>
            <field name="description">Sent to notify users about the weather alert.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Tomorrow, the temperature may exceed “
                        <strong>
                            <span t-out="object.temp_max"/>
                        </strong>
                        ”, the wind speed may be more than “
                        <strong>
                            <span t-out="object.wind_max"/>
                        </strong>
                        ” and the total amount of precipitation is “
                        <strong>
                            <span t-out="object.amount_precipitation"/>
                        </strong>
                        ”.
                    </p>
                </div>
            </field>
            <field name="lang">{{ user.company_id.partner_id.lang }}</field>
            <field
                    name="report_template_ids"
                    eval="[(6, 0, [
                   ref('weather.weather_alert_report_action'),
               ])]"
            />
        </record>

    </data>
</odoo>