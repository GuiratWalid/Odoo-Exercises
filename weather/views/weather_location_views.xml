<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="weather_location_list_view" model="ir.ui.view">
        <field name="name">weather.location.list</field>
        <field name="model">weather.location</field>
        <field name="arch" type="xml">
            <list default_order="name asc">
                <field name="name"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="city"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="weather_location_form_view" model="ir.ui.view">
        <field name="name">weather.location.form</field>
        <field name="model">weather.location</field>
        <field name="arch" type="xml">
            <form create="1">
                <header>
                    <button name="get_coordinates"
                            type="object"
                            string="Get Coordinates"
                            class="btn-primary"
                            invisible="latitude and longitude"
                    />
                </header>
                <sheet>
                    <div>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="country_id" readonly="latitude and longitude"/>
                            <field name="state_id"
                                   context="{'default_country_id': country_id}"
                                   domain="country_id and [('country_id', '=', country_id)] or []"
                                   readonly="latitude and longitude"
                            />
                            <field name="city" readonly="latitude and longitude"/>
                        </group>

                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>

                        <notebook>
                            <page name="users_list" string="Users List">
                                <field name="user_ids"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="weather_location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">weather.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>