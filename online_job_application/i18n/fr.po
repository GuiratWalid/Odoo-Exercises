#. module: online_job_application
#: model:mail.template,description:online_job_application.email_template_application_status
msgid ""
"\n"
"                This mail is sent when an application status is updated.\n"
"            "
msgstr ""
"\n"
"                Ce courrier est envoyé lorsqu'un statut de candidature est mis à jour.\n"
"            "

#. module: online_job_application
#: model:mail.template,subject:online_job_application.email_template_application_status
msgid ""
"\n"
"                Your Application Status for \"{{object.job_position_id.name or ''}}\" Has Changed\n"
"            "
msgstr ""
"\n"
"                Le statut de candidature pour le poste \"{{object.job_position_id.name or ''}}\" a été modifié\n"
"            "

#. module: online_job_application
#: model:mail.template,body_html:online_job_application.email_template_application_status
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear\n"
"                        <span t-out=\"object.name\"/>,\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p>Your application status for the position <strong><span t-out=\"object.job_position_id.name\"/></strong> has been updated:</p>\n"
"                    <ul>\n"
"                        <li>\n"
"                            Status:\n"
"                            <strong><span t-out=\"object.state\"/></strong>\n"
"                        </li>\n"
"                    </ul>\n"
"                    <p>Thank you for your interest in our company.</p>\n"
"                    <br/>\n"
"                    <p>Best regards,</p>\n"
"                    <p>The Recruitment Team</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Cher(e)\n"
"                        <span t-out=\"object.name\"/>,\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p>Le statut de candidature pour le poste <strong><span t-out=\"object.job_position_id.name\"/></strong> a été modifié:</p>\n"
"                    <ul>\n"
"                        <li>\n"
"                            Statut:\n"
"                            <strong><span t-out=\"object.state\"/></strong>\n"
"                        </li>\n"
"                    </ul>\n"
"                    <p>Nous vous remercions de l'intérêt que vous portez à notre entreprise.</p>\n"
"                    <br/>\n"
"                    <p>Bien à vous,</p>\n"
"                    <p>L'Equipe de recrutement</p>\n"
"                </div>\n"
"            "

